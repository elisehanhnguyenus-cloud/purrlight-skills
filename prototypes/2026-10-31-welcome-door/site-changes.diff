+/* ---------- page to page (31/10 preview): one soft cross-fade between pages, the header staying put, in browsers that
+   support cross-document view transitions (others simply load the next page). Off with reduced motion. ---------- */
+@media (prefers-reduced-motion: no-preference) {
+  @view-transition { navigation: auto; }
+  ::view-transition-old(root) { animation: pl-page-out 0.18s ease-in both; }
+  ::view-transition-new(root) { animation: pl-page-in 0.34s cubic-bezier(0.2, 0.7, 0.2, 1) both; }
+  .site-header { view-transition-name: site-header; }
+}
+@keyframes pl-page-out { to { opacity: 0; } }
+@keyframes pl-page-in { from { opacity: 0; transform: translateY(10px); } }
